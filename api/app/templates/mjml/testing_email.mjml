<mjml>
  <mj-body background-color="#fafbfc">
    <mj-section background-color="#fff" padding="40px 20px">
      <mj-column vertical-align="middle" width="100%">
        <mj-text align="center" padding="35px 35px 15px" font-size="20px" font-family="Arial, Helvetica, sans-serif" color="#333">{{ project_name }}</mj-text>
        <mj-divider border-color="#eee" border-width="1px" padding="10px 25px 20px"></mj-divider>
        <mj-text align="center" font-size="16px" padding-left="25px" padding-right="25px" font-family=", sans-serif"><span>This e-mail is for testing purpose.</span></mj-text>
        <mj-divider border-color="#ccc" border-width="1px"></mj-divider>
        <mj-text align="center" padding="50px 0 0">{{ sender_address }}</mj-text>
        <mj-text align="center" padding="20px 0 0">This e-mail has been sent to {{ email }}</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
